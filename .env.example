# ==============================================================================
# ASHOS — environment template.  Copy to .env and fill in.  NEVER commit .env.
# ==============================================================================

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-scripts/gen_secret.py
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_LANGUAGE_CODE=en-us

# --- Database (pgvector-enabled PostgreSQL) -----------------------------------
# Use 127.0.0.1, never "localhost". On Windows "localhost" resolves to ::1 first,
# Docker publishes on 127.0.0.1 only, and the IPv6 attempt stalls ~130s before
# falling back — every management command looks like it has hung. Same for Redis.
POSTGRES_DB=ashos
POSTGRES_USER=ashos
POSTGRES_PASSWORD=ashos
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgres://ashos:ashos@127.0.0.1:5432/ashos
DB_CONN_MAX_AGE=60

# --- Redis (cache + channels + celery broker) ---------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/3
# In dev, an unreachable Redis falls back to in-process cache/channels so the app
# still runs. Set this to true to get the connection error instead — do that
# before trusting anything that needs a shared cache or a Celery worker.
DEV_REQUIRE_REDIS=False

# --- Object storage (MinIO / S3) ----------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=ashosminio
AWS_SECRET_ACCESS_KEY=ashosminio
AWS_STORAGE_BUCKET_NAME=ashos-media
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# ==============================================================================
# AI GATEWAY (D07) — every AI call in ASHOS resolves through these settings.
# Values here are BOOTSTRAP DEFAULTS only; once AI Center has rows in
# ai_model_config, the database wins.  This keeps the system bootable before
# anyone has logged into the admin.
# ==============================================================================

# LLM — any OpenAI-compatible endpoint (OpenAI, Azure, Groq, Together, vLLM…)
AI_LLM_PROVIDER=openai_compatible
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_TEMPERATURE=0.2
AI_LLM_MAX_TOKENS=1024
AI_LLM_TIMEOUT_S=30
AI_LLM_FALLBACK_MODEL=

# Text embeddings — must match kb_chunk.embedding dimension (D08)
AI_EMBEDDING_PROVIDER=openai_compatible
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536

# Image embeddings (CLIP) — must match hotel_image.embedding dimension
AI_IMAGE_EMBEDDING_PROVIDER=local_clip
AI_IMAGE_EMBEDDING_MODEL=ViT-B-32
AI_IMAGE_EMBEDDING_DIM=512

# Face recognition — must match guest_face.embedding dimension
AI_FACE_PROVIDER=local_insightface
AI_FACE_MODEL=buffalo_l
AI_FACE_DIM=512
AI_FACE_MATCH_THRESHOLD=0.38
AI_FACE_LIVENESS_REQUIRED=True

# Speech
AI_STT_PROVIDER=openai_compatible
AI_STT_MODEL=whisper-1
AI_TTS_PROVIDER=openai_compatible
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=nova

# OCR
AI_OCR_PROVIDER=paddleocr
AI_OCR_LANGS=en,bn

# --- AI safety & cost controls (D11, D12, R3) ---------------------------------
AI_ENABLED=True
AI_KILL_SWITCH=False
AI_CONFIDENCE_THRESHOLD=0.55
AI_MAX_CONVERSATION_TURNS=30
AI_SESSION_TOKEN_CAP=20000
AI_DAILY_COST_CAP_USD=25
AI_COST_ALERT_WEBHOOK=

# --- Notifications ------------------------------------------------------------
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=ASHOS
WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@ashos.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Payments (Q4 — provider not yet chosen) ----------------------------------
PAYMENT_PROVIDER=manual
PAYMENT_SANDBOX=True
PAYMENT_STORE_ID=
PAYMENT_STORE_SECRET=

# --- Guest face capture (D10) -------------------------------------------------
# Master switch for taking a guest's photo after a confirmed booking. A property
# must ALSO have Hotel.biometric_enabled on (Settings -> AI), so one mis-set
# variable here cannot turn it on for every tenant.
#
# Before setting this True, know what it commits the operator to: a photograph of
# an identifiable person is special-category data in most jurisdictions. What the
# code already guarantees — consent recorded with the wording version, encrypted
# at rest, hard-deleted at the retention window, erasable on request — is the
# implementation, not the authorisation. That part is yours.
BIOMETRIC_ENABLED=False
# Keep the frames as images (what makes a person able to compare them at the
# desk). False keeps the consent ledger and stores no photograph.
BIOMETRIC_STORE_RAW_IMAGE=False
BIOMETRIC_RETENTION_DAYS=90

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=False
